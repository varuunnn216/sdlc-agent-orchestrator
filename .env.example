# Multi-provider LLM configuration (order of automatic failover)
LLM_PROVIDER_ORDER=groq,cerebras,gemini

GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

CEREBRAS_API_KEY=your-cerebras-api-key-here
CEREBRAS_MODEL=gpt-oss-120b

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Optional local provider via Ollama (add "ollama" to LLM_PROVIDER_ORDER)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional: legacy Anthropic key (used only if explicitly requested)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GitHub PR integration (real PRs disabled unless ALLOW_REAL_PR=true)
GITHUB_TOKEN=your-github-token-here
GITHUB_REPO=varuunnn216/sdlc-agent-orchestrator
ALLOW_REAL_PR=false

# Public demo rate limits
DEMO_MAX_RUNS_PER_IP_PER_DAY=5
DEMO_MAX_GLOBAL_RUNS_PER_DAY=50
